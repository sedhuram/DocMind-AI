GEMINI_API_KEY=your-gemini-api-key-here

# Base URL the frontend uses to reach the backend API. This is inlined into the
# Next.js client bundle at BUILD time (docker-compose passes it as a build arg
# to frontend/Dockerfile), not read at container runtime. Change this if the
# backend is deployed at a non-default host/port, then rebuild the frontend
# image (`docker compose build frontend`) for the change to take effect.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
