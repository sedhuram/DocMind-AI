GEMINI_API_KEY=your-gemini-api-key-here
DEFAULT_LLM_PROVIDER=gemini
# OLLAMA_BASE_URL below is the value for running the backend directly on your machine
# (`uvicorn app.main:app`). Under `docker compose up` you do NOT need to set it: inside a
# container `localhost` is the container itself, not your machine, so compose already
# defaults this to http://host.docker.internal:11434 (with an extra_hosts entry so that
# name resolves on Linux hosts too). Only set OLLAMA_BASE_URL explicitly if Ollama lives
# somewhere other than the host machine's default port.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.6:35b

# Base URL the frontend uses to reach the backend API. This is inlined into the
# Next.js client bundle at BUILD time (docker-compose passes it as a build arg
# to frontend/Dockerfile), not read at container runtime. Change this if the
# backend is deployed at a non-default host/port, then rebuild the frontend
# image (`docker compose build frontend`) for the change to take effect.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
