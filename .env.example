GEMINI_API_KEY=your-gemini-api-key-here
DEFAULT_LLM_PROVIDER=gemini
# OLLAMA_BASE_URL is commented out on purpose -- leave it unset unless you're running the
# backend directly on your machine (`uvicorn app.main:app`), where `localhost` correctly
# means "this machine". Under `docker compose up`, `localhost` inside a container means
# the container itself, not your machine, so compose already defaults this var to
# http://host.docker.internal:11434 (with an extra_hosts entry so that name resolves on
# Linux hosts too) -- uncommenting the line below with a `localhost` value would silently
# override that default and break the Docker path. Only set it explicitly if Ollama lives
# somewhere other than the host machine's default port.
# OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.6:35b
# By default Ollama only listens on 127.0.0.1, which a Docker container can't reach even
# via host.docker.internal. If you're using the Docker path with a host-installed Ollama,
# start it with OLLAMA_HOST=0.0.0.0 so the container-to-host connection can actually land.

# Base URL the frontend uses to reach the backend API. This is inlined into the
# Next.js client bundle at BUILD time (docker-compose passes it as a build arg
# to frontend/Dockerfile), not read at container runtime. Change this if the
# backend is deployed at a non-default host/port, then rebuild the frontend
# image (`docker compose build frontend`) for the change to take effect.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
